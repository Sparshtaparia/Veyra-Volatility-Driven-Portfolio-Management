# ==============================================================
# Veyra — Environment Variables Example
# Copy this file to .env and fill in the values.
# NEVER commit .env to version control.
# ==============================================================

# Supabase: Project settings > Database > Connection string (URI, transaction pooler)
DATABASE_URL=postgresql+psycopg2://postgres.PROJECT_REF:YOUR_PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?sslmode=require
SUPABASE_URL=https://PROJECT_REF.supabase.co
# Safe to expose to the browser. Never use the service-role key in the frontend.
SUPABASE_ANON_KEY=your-supabase-anon-key
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
APP_ENV=development
LOG_LEVEL=INFO
API_PREFIX=/api/v1
DEFAULT_CURRENCY=INR
DEFAULT_EVALUATION_FREQUENCY=MONTHLY
