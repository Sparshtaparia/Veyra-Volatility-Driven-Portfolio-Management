# ==============================================================
# Veyra — Environment Variables Example
# Copy this file to .env and fill in the values.
# NEVER commit .env to version control.
# ==============================================================

# ---------------------------------------------------------------
# Supabase — Database & Auth
# ---------------------------------------------------------------
# Your Supabase project URL (Project Settings → API)
SUPABASE_URL=https://PROJECT_REF.supabase.co

# Publishable (anon) key — safe for server-side calls, NOT for secrets
# Maps to SUPABASE_PUBLISHABLE_KEY if your Supabase dashboard uses that label
SUPABASE_ANON_KEY=your-supabase-anon-key

# Secret (service-role) key — NEVER expose to the browser or frontend code
# Maps to SUPABASE_SECRET_KEY if your Supabase dashboard uses that label
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# JWKS URL for JWT verification by the FastAPI backend
SUPABASE_JWKS_URL=https://PROJECT_REF.supabase.co/auth/v1/.well-known/jwks.json

# ---------------------------------------------------------------
# Database — Supabase PostgreSQL (Transaction Pooler)
# ---------------------------------------------------------------
# Use the Transaction Pooler connection string from:
#   Supabase Dashboard → Project Settings → Database → Connection string
# Port 6543 = Transaction Pooler (recommended for serverless/pooled connections)
DATABASE_URL=postgresql+psycopg2://postgres.PROJECT_REF:YOUR_PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?sslmode=require

# ---------------------------------------------------------------
# Application
# ---------------------------------------------------------------
# A 32+ character key for API-key authentication when Supabase auth is not used.
# Never expose this value to a browser or commit a real key.
VEYRA_API_KEY=replace-with-a-32-character-or-longer-random-value

# JSON lists of browser origins and HTTP Host values accepted by the backend.
# Use explicit production domains; wildcard values are rejected in production.
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
TRUSTED_HOSTS=["localhost","127.0.0.1","testserver"]

APP_ENV=development
# Local development escape hatch only. NEVER enable this in production.
AUTH_BYPASS_ENABLED=false
DEV_AUTH_USER_ID=00000000-0000-0000-0000-000000000001
LOG_LEVEL=INFO
API_PREFIX=/api/v1
STRUCTURED_JSON_LOGS=true
DEFAULT_CURRENCY=INR
DEFAULT_EVALUATION_FREQUENCY=DAILY

# ---------------------------------------------------------------
# Connection Pool (tune for Supabase pooler limits)
# ---------------------------------------------------------------
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_TIMEOUT_SECONDS=30
DATABASE_POOL_RECYCLE_SECONDS=900
DATABASE_CONNECT_TIMEOUT_SECONDS=10

# ---------------------------------------------------------------
# Market Data
# ---------------------------------------------------------------
MARKET_DATA_PROVIDER=yfinance
# Independent optional fallback. It is skipped cleanly when its API key is absent.
MARKET_DATA_SECONDARY_PROVIDER=alpha_vantage
ALPHA_VANTAGE_API_KEY=your-alpha-vantage-api-key
# Yahoo-backed tertiary fallback; yfinance and yahoo_chart share Yahoo infrastructure.
MARKET_DATA_FALLBACK_PROVIDER=yahoo_chart
MARKET_DATA_RETRY_ATTEMPTS=3
MARKET_DATA_BACKOFF_SECONDS=0.25
MARKET_DATA_MAX_BACKOFF_SECONDS=4
MARKET_DATA_TIMEOUT_SECONDS=20
MARKET_DATA_REQUESTS_PER_SECOND=2
MARKET_DATA_MAX_STALENESS_DAYS=5
MARKET_DATA_CACHE_TTL_SECONDS=900

# ---------------------------------------------------------------
# Scheduler (optional)
# ---------------------------------------------------------------
SCHEDULER_ENABLED=false
SCHEDULER_TIMEZONE=UTC
SCHEDULED_EVALUATION_CRON=0 2 * * 1-5
SCHEDULED_VOLATILITY_CRON=0 */6 * * 1-5
SCHEDULER_RUN_LOCK_TIMEOUT_MINUTES=120

# Quant — repo-relative official Ken French daily five-factor cache
FAMA_FRENCH_DATA_PATH=data/fama_french/F-F_Research_Data_5_Factors_2x3_daily.csv
