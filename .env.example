# ==============================================================
# Veyra — Environment Variables Example
# Copy this file to .env and fill in the values.
# NEVER commit .env to version control.
# ==============================================================

DATABASE_URL=postgresql+psycopg2://<user>:<password>@<host>:5432/<database>?sslmode=require
VEYRA_API_KEY=<generate-at-least-32-random-characters>
FAMA_FRENCH_DATA_PATH=/absolute/path/to/fama_french_five_factor.csv
APP_ENV=production
LOG_LEVEL=INFO
API_PREFIX=/api/v1
CORS_ORIGINS=["https://veyra.example.com"]
TRUSTED_HOSTS=["api.veyra.example.com"]
STRUCTURED_JSON_LOGS=true

DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_TIMEOUT_SECONDS=30
DATABASE_POOL_RECYCLE_SECONDS=900
DATABASE_CONNECT_TIMEOUT_SECONDS=10

MARKET_DATA_PROVIDER=yfinance
MARKET_DATA_FALLBACK_PROVIDER=yahoo_chart
MARKET_DATA_RETRY_ATTEMPTS=3
MARKET_DATA_BACKOFF_SECONDS=0.25
MARKET_DATA_MAX_BACKOFF_SECONDS=4
MARKET_DATA_TIMEOUT_SECONDS=20
MARKET_DATA_REQUESTS_PER_SECOND=2
MARKET_DATA_MAX_STALENESS_DAYS=5
MARKET_DATA_CACHE_TTL_SECONDS=900

SCHEDULER_ENABLED=false
SCHEDULER_TIMEZONE=UTC
SCHEDULED_EVALUATION_CRON=0 2 * * 1-5
SCHEDULED_VOLATILITY_CRON=0 */6 * * 1-5
SCHEDULER_RUN_LOCK_TIMEOUT_MINUTES=120

DEFAULT_CURRENCY=INR
DEFAULT_EVALUATION_FREQUENCY=MONTHLY
