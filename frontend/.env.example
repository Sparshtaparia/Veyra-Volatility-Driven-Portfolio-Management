# ==============================================================
# Veyra Frontend — Environment Variables Example
# Copy this file to frontend/.env and fill in the values.
# NEVER commit frontend/.env to version control.
# ==============================================================

# Backend API base URL (default: localhost for local dev)
VITE_API_BASE_URL=http://127.0.0.1:8000/api/v1

# Supabase project URL (Project Settings → API)
VITE_SUPABASE_URL=https://PROJECT_REF.supabase.co

# Supabase publishable (anon) key — safe to expose to the browser
# NEVER put SUPABASE_SERVICE_ROLE_KEY or SUPABASE_SECRET_KEY here.
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
