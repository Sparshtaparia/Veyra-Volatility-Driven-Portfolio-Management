# ==============================================================
# Veyra — Environment Variables Example
# Copy this file to .env and fill in the values.
# NEVER commit .env to version control.
# ==============================================================

DATABASE_URL=postgresql+psycopg2://veyra:veyra@localhost:5432/veyra
FAMA_FRENCH_DATA_PATH=
APP_ENV=development
LOG_LEVEL=INFO
API_PREFIX=/api/v1
CORS_ORIGINS=["http://localhost:5173"]
DEFAULT_CURRENCY=INR
DEFAULT_EVALUATION_FREQUENCY=MONTHLY
# Frontend build-time API base; use /api/v1 behind the bundled reverse proxy.
VITE_API_BASE_URL=/api/v1
