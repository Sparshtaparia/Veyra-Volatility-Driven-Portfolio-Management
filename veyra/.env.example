# ==============================================================
# Veyra — Environment Variables Example
# Copy this file to .env and fill in the values.
# NEVER commit .env to version control.
# ==============================================================

DATABASE_URL=postgresql+psycopg2://veyra:veyra@localhost:5432/veyra
FAMA_FRENCH_DATA_PATH=
APP_ENV=development
LOG_LEVEL=INFO
API_PREFIX=/api/v1
DEFAULT_CURRENCY=INR
DEFAULT_EVALUATION_FREQUENCY=MONTHLY
